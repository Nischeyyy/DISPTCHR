# DISPTCHR Guard App — Expo web export, served as static files at /
# (Native iOS/Android builds are produced separately; this image is the browser build only.)
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json yarn.lock ./
# scripts/ is needed by the package.json preinstall hook.
COPY scripts ./scripts
RUN yarn install --frozen-lockfile --network-timeout 600000
COPY . .
# Empty backend URL => the API client uses relative "/api", which the edge router
# forwards to the api service on the same domain (no CORS, no hard-coded hosts).
ENV EXPO_PUBLIC_BACKEND_URL=""
RUN npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ >/dev/null || exit 1
