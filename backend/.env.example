# Copy to backend/.env for local (non-Replit) use, or set these as Replit Secrets.
# On Replit: MONGO_URL and JWT_SECRET are managed via the Secrets pane (requestSecrets),
# never committed here with real values.

# MongoDB Atlas connection string, e.g. mongodb+srv://<credentials>@<cluster-host>/
MONGO_URL=

# Database name (non-secret; also set as a shared Replit env var)
DB_NAME=skyhawk_ops

# Secret used to sign JWT auth tokens (any long random string)
JWT_SECRET=

# Server-to-server key used only by the directors' Disptchr Panel to manage
# manager accounts and permissions. Use a different long random value in production.
CONTROL_PANEL_API_KEY=

# Optional
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
MANAGER_SESSION_HOURS=8
REFRESH_TOKEN_DAYS=30
APP_ENV=development
ALLOW_PUBLIC_REGISTRATION=false
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5050,http://localhost:5050,http://127.0.0.1:3000,http://localhost:3000
RATE_LIMIT_STORAGE_URI=memory://
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ca-central-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Generate with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PII_ENCRYPTION_KEY=

# Production monitoring. METRICS_TOKEN protects /internal/metrics; Sentry is optional.
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Transactional providers are optional in local development and required in production.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Real company dispatch line in E.164 format. Required in production.
DISPATCH_PHONE=

# Optional when Expo push access-token security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=
