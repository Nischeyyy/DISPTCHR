# DISPTCHR deployment variables.
# Copy to .env for `docker compose up`, or paste the same keys into Openship -> Project -> Environment.
# Never commit a real .env.

# --- Required -------------------------------------------------------------
# Long random string used to sign JWTs. Generate: openssl rand -hex 32
JWT_SECRET=

# Independent encryption key for SIN and banking fields.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PII_ENCRYPTION_KEY=

# Server-to-server key shared only with Disptchr Panel.
CONTROL_PANEL_API_KEY=

# --- Managed dependencies -------------------------------------------------
# Production must use a managed MongoDB deployment with backups/PITR.
MONGO_URL=
DB_NAME=disptchr

# --- Auth tuning (optional) ----------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
MANAGER_SESSION_HOURS=8
REFRESH_TOKEN_DAYS=30
APP_ENV=production
ALLOW_PUBLIC_REGISTRATION=false
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://YOUR-DISPTCHR-DOMAIN,https://YOUR-MANAGER-DOMAIN
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Private S3-compatible object storage. Standard AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY variables are read by the AWS SDK when needed.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=ca-central-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring and error reporting
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production notification channels (required in production) ------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=

# Real company dispatch line in E.164 format.
DISPATCH_PHONE=
