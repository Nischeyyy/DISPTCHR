# DISPTCHR deployment variables.
# Copy to .env for `docker compose up`, or paste the same keys into Openship -> Project -> Environment.
# Never commit a real .env.

# --- Required -------------------------------------------------------------
# Long random string used to sign JWTs. Generate: openssl rand -hex 32
JWT_SECRET=

# --- Database -------------------------------------------------------------
# Default = bundled mongo service in docker-compose.yml.
# For MongoDB Atlas: MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net  (then disable the mongo service)
MONGO_URL=mongodb://mongo:27017
DB_NAME=disptchr

# --- Auth tuning (optional) ----------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# --- Notification channels (optional; each is disabled cleanly when empty) --
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENT_PUSH_KEY=
